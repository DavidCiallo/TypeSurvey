# ---- frontend (rsbuild + bun) ----
FROM oven/bun:1-alpine AS web
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY rsbuild.config.ts tsconfig.json postcss.config.mjs components.json ./
COPY client/ ./client/
COPY shared/ ./shared/
RUN bun run build

# ---- server (pure-Go, no CGo) ----
FROM golang:1.23-alpine AS api
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/typesurvey .

# ---- runtime ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=api /out/typesurvey ./typesurvey
COPY --from=web /app/dist ./dist
RUN mkdir -p data
ENV DATA_DIR=/data
VOLUME /data
EXPOSE 3000
CMD ["./typesurvey"]
